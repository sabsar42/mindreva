# --- Database -----------------------------------------------------------
# Postgres connection string for Drizzle. On Vercel/serverless use Supabase's
# TRANSACTION POOLER string (port 6543, ...pooler.supabase.com), not the direct
# 5432 connection. Drizzle connects as the service role and BYPASSES RLS, so
# repositories must always scope queries by user_id (see packages/database).
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Supabase -------------------------------------------------------------
# Server-side Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=
# Public anon key, safe to expose to the client.
SUPABASE_ANON_KEY=
# Server-only service role key, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Client-visible duplicates for the browser Supabase client (@supabase/ssr).
# Must be prefixed NEXT_PUBLIC_ to be bundled; same values as the two above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ASR (speech-to-text) provider ----------------------------------------
# Which ASRProvider implementation to use: groq | huggingface | nemotron-self-hosted
ASR_PROVIDER=groq
# API key for Groq's hosted Whisper endpoint (MVP default provider).
GROQ_API_KEY=
# API key for the Hugging Face Inference API (documented fallback ASR provider).
HUGGINGFACE_API_KEY=

# --- LLM (summaries + chat) provider ---------------------------------------
# Which LLMProvider implementation to use: gemini | groq | claude | openrouter
#
# TEMPORARY: set to "openrouter" right now, not "gemini". The Gemini API key's
# Google Cloud project is hitting a hard account/region-level quota wall
# (quota_limit_value=0 in every project tried, not a normal rate limit) —
# unrelated to this codebase. Revert to LLM_PROVIDER=gemini once that's
# resolved; GeminiLLMProvider is unchanged and ready to go.
LLM_PROVIDER=openrouter
# API key for Gemini 2.5 Flash (long-term default LLM + embeddings provider).
GEMINI_API_KEY=
# API key for Claude API (selectable premium provider, added post-monetization).
ANTHROPIC_API_KEY=
# API key for OpenRouter (temporary stand-in provider, see LLM_PROVIDER above).
OPENROUTER_API_KEY=
# Chat completion model on OpenRouter. Free NVIDIA Nemotron model. The free
# tier's available models rotate as OpenRouter/upstream providers retire and
# add them — if this one starts 404ing ("No endpoints found"), check
# https://openrouter.ai/models?max_price=0 for a current replacement.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Tried in order after OPENROUTER_MODEL (comma-separated), then
# openrouter/free as the last resort. Pick general-purpose :free chat models
# from DIFFERENT vendors than the primary, so one upstream outage can't take
# all of them down. Checked live on 2026-10-22; they rotate, so re-check
# https://openrouter.ai/models?max_price=0 when summaries start falling back.
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m3.1-flash:free,poolside/laguna-s-2.1:free
# Embedding model on OpenRouter — a DIFFERENT model from OPENROUTER_MODEL above,
# do not collapse these into one variable.
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# When every OpenRouter model fails (or the free daily quota is used up),
# completions go to this provider instead. Embeddings never do. Uses
# GROQ_API_KEY above. Leave empty to disable.
LLM_FALLBACK_PROVIDER=groq
# Groq chat model for that fallback. Groq retires models without notice
# (llama-3.3-70b-versatile now 404s); list current ones with
# GET https://api.groq.com/openai/v1/models.
GROQ_LLM_MODEL=openai/gpt-oss-120b

# --- Sentry (error tracking) ------------------------------------------------
# From your Sentry project → Settings → Client Keys (DSN). The NEXT_PUBLIC_
# version is bundled into the browser; SENTRY_DSN (no prefix) is what the
# server/edge configs fall back to if the public one isn't set, so in
# practice you can just set NEXT_PUBLIC_SENTRY_DSN and leave this blank.
# Sentry is a safe no-op everywhere if this is unset — nothing breaks without it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Only needed for source-map upload during `next build` (so stack traces in
# Sentry show real file:line instead of minified bundle code). From Sentry →
# Settings → Auth Tokens. Never expose this to the client — it's build-time
# only, never referenced with a NEXT_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Support (optional, voluntary) -------------------------------------------
# A tip page (Ko-fi, Buy Me a Coffee, ...). Shown as "Support Mindreva" on the
# Account screen and in small footers, opened in a new tab. It is voluntary and
# unlocks nothing; leave it empty to hide the link entirely. https:// only.
NEXT_PUBLIC_SUPPORT_URL=
# The SupportKori tip button on the Account screen (a small floating widget
# loaded from supportkori.com, voluntary, unlocks nothing). Defaults to the
# project's handle; set another handle, or "off" to hide it.
NEXT_PUBLIC_SUPPORT_WIDGET_ID=

# Optional: where privacy and account-deletion requests go. Shown on the
# Privacy and Terms pages only when set.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Past-self search (optional) --------------------------------------------
# Unlocks the daily /api/cron/embeddings job (vercel.json) that catches up
# embedding work for every user. Vercel sends it as a Bearer token on cron
# requests. Unset = the route refuses every request.
CRON_SECRET=
# Minimum cosine similarity for a search hit to count as evidence. Leave
# empty to use the calibrated default in apps/web/lib/retrieval/retrieve.ts.
RETRIEVAL_MIN_SIMILARITY=

# --- Public site (optional) --------------------------------------------------
# The canonical origin for share previews, the sitemap and robots.txt, e.g.
# https://mindreva.app. Unset: the Vercel production URL is used.
NEXT_PUBLIC_SITE_URL=

# --- Google Calendar (optional, read-only) -----------------------------------
# All four must be set, or the integration stays off and every calendar row
# and section is hidden. Server-only: never prefix these with NEXT_PUBLIC_.
# From Google Cloud Console > APIs & Services > Credentials > OAuth client
# (type "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on that OAuth client exactly, e.g.
# http://localhost:3000/api/integrations/google-calendar/callback (dev) or
# https://<your-domain>/api/integrations/google-calendar/callback (prod).
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Encrypts stored refresh tokens (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes existing connections unreadable (users reconnect).
CALENDAR_TOKEN_KEY=
