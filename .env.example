# --- Database -----------------------------------------------------------
# Postgres connection string for Drizzle. On Vercel/serverless use Supabase's
# TRANSACTION POOLER string (port 6543, ...pooler.supabase.com), not the direct
# 5432 connection. Drizzle connects as the service role and BYPASSES RLS, so
# repositories must always scope queries by user_id (see packages/database).
# Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Supabase -------------------------------------------------------------
# Server-side Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=
# Public anon key, safe to expose to the client.
SUPABASE_ANON_KEY=
# Server-only service role key, bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Client-visible duplicates for the browser Supabase client (@supabase/ssr).
# Must be prefixed NEXT_PUBLIC_ to be bundled; same values as the two above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- ASR (speech-to-text) provider ----------------------------------------
# Which ASRProvider implementation to use: groq | huggingface | nemotron-self-hosted
ASR_PROVIDER=groq
# API key for Groq's hosted Whisper endpoint (MVP default provider).
GROQ_API_KEY=
# API key for the Hugging Face Inference API (documented fallback ASR provider).
HUGGINGFACE_API_KEY=

# --- LLM (summaries + chat) provider ---------------------------------------
# Which LLMProvider implementation to use: gemini | groq | claude | openrouter
#
# TEMPORARY: set to "openrouter" right now, not "gemini". The Gemini API key's
# Google Cloud project is hitting a hard account/region-level quota wall
# (quota_limit_value=0 in every project tried, not a normal rate limit) —
# unrelated to this codebase. Revert to LLM_PROVIDER=gemini once that's
# resolved; GeminiLLMProvider is unchanged and ready to go.
LLM_PROVIDER=openrouter
# API key for Gemini 2.5 Flash (long-term default LLM + embeddings provider).
GEMINI_API_KEY=
# API key for Claude API (selectable premium provider, added post-monetization).
ANTHROPIC_API_KEY=
# API key for OpenRouter (temporary stand-in provider, see LLM_PROVIDER above).
OPENROUTER_API_KEY=
# Chat completion model on OpenRouter. Free NVIDIA Nemotron model.
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
# Embedding model on OpenRouter — a DIFFERENT model from OPENROUTER_MODEL above,
# do not collapse these into one variable.
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
